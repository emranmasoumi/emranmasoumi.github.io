---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/publications';
---

<BaseLayout title="Research — Emran Masoumifeshani">
  <section class="section-shell research-hero">
    <div class="research-hero-copy">
      <p class="eyebrow">Research</p>
      <h1>Computational Chemistry & Scientific Computing</h1>
      <p>
        My research combines computational chemistry, molecular modeling and
        scientific software development, with a focus on molecular
        fragmentation, intermolecular interactions and automation of
        computational workflows.
      </p>
    </div>
  </section>

  <section class="section-shell publications-section">
    <div class="publications-header">
      <div>
        <p class="eyebrow">Publications</p>
        <h2>Selected research contributions.</h2>
      </div>
      <span class="publication-count">{publications.length} publications</span>
    </div>

    <div class="publications-list">
      {publications.map((publication) => (
        <article class="publication">
          <div class="publication-year">
            {publication.year}
          </div>

          <div class="publication-content">
            <h3>{publication.title}</h3>

            <p class="publication-authors">
              {publication.authors.split('E. Masoumifeshani').map((part, index, parts) => (
                <>
                  {part}
                  {index < parts.length - 1 && <strong>E. Masoumifeshani</strong>}
                </>
              ))}
            </p>

            <div class="publication-meta">
              <span>
                <em>{publication.journal}</em>
                {publication.volume && ` · ${publication.volume}`}
                {publication.issue && `(${publication.issue})`}
                {publication.pages && ` · ${publication.pages}`}
              </span>

              <a
                href={`https://doi.org/${publication.doi}`}
                target="_blank"
                rel="noopener noreferrer"
                class="publication-doi"
              >
                DOI ↗
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell contact-band research-cta">
    <div>
      <p class="eyebrow">Research & Collaboration</p>
      <h2>Interested in computational research or scientific software?</h2>
      <p>
        I am interested in applying computational methods, software engineering
        and AI to challenging scientific problems.
      </p>
    </div>

    <a class="text-link" href="/contact">
      Get in touch →
    </a>
  </section>
</BaseLayout>
