---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    id: '01',
    title: 'AI-Powered Product Recommendation System',
    desc: 'An AI-powered e-commerce system combining room visualization, image processing and product recommendation workflows.',
    stack: 'Python · FastAPI · AI / Computer Vision · Docker',
    slug: 'ai-product-recommendation'
  },
  {
    id: '02',
    title: 'Customer Segmentation & E-Commerce Analytics',
    desc: 'An end-to-end machine learning pipeline that transforms transactional data into customer segments and business insights.',
    stack: 'Python · Pandas · scikit-learn · Machine Learning',
    slug: 'customer-segmentation'
  },
  {
    id: '03',
    title: 'RAG Document Assistant',
    desc: 'A modular Retrieval-Augmented Generation application for document question answering with LLMs.',
    stack: 'Python · RAG · LLMs · LangChain · FastAPI',
    slug: 'rag-document-assistant'
  },
  {
    id: '04',
    title: 'Scientific Computing & Automation Software',
    desc: 'AROFRAG automates molecular fragmentation and computational workflows for quantum chemistry research.',
    stack: 'Python · C++ · Scientific Computing · Automation',
    slug: 'arofrag'
  }
];

const skills = [
  'AI Engineering',
  'Machine Learning',
  'LLMs & RAG',
  'AI Agents',
  'Python',
  'C++',
  'FastAPI',
  'Docker',
  'Scientific Computing',
  'Quantum Chemistry',
  'Data Science',
  'Linux'
];

const journey = [
  {
    year: '2013 — 2018',
    title: 'Industrial Engineering',
    place: 'Niroutrans',
    desc: 'Engineering and technical work in the transformer industry.'
  },
  {
    year: '2018 — 2023',
    title: 'PhD · Quantum Chemistry',
    place: 'University of Warsaw',
    desc: 'Computational chemistry, molecular modeling and scientific software development.'
  },
  {
    year: '2023 — 2025',
    title: 'Scientific Computing',
    place: 'Institute of Organic Chemistry, Polish Academy of Sciences',
    desc: 'Computational research and development of scientific computing workflows.'
  },
  {
    year: '2025 — Present',
    title: 'AI / ML Engineering',
    place: 'Intelligent Systems',
    desc: 'Building practical AI systems across machine learning, LLMs, data and software engineering.'
  }
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero section-shell">
    <div class="hero-copy">
      <div class="availability">
        <span></span>
        Open to AI / ML opportunities
      </div>

      <p class="eyebrow">Emran Masoumifeshani</p>

      <h1>
        From modeling molecules
        <span>to building intelligent systems.</span>
      </h1>

      <p class="hero-role">
        PhD Scientist · AI/ML Engineer · Data Scientist
      </p>

      <p class="hero-intro">
        I combine scientific reasoning, machine learning and software engineering
        to build intelligent systems for complex real-world problems.
      </p>

      <div class="hero-actions">
        <a class="btn primary" href="/projects">
          Explore My Work
          <span>↗</span>
        </a>

        <a class="btn secondary" href="/cv/CV_Emran_Masoumifeshani.pdf">
          Download CV
        </a>
      </div>

      <div class="social-row">
        <a href="https://github.com/emranmasoumi" target="_blank" rel="noreferrer">
          GitHub ↗
        </a>

        <a href="https://www.linkedin.com/in/emran-masoumifeshani/" target="_blank" rel="noreferrer">
          LinkedIn ↗
        </a>

        <a href="mailto:emran.masoumifeshani@gmail.com">
          Email ↗
        </a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-orbit orbit-one"></div>
      <div class="hero-orbit orbit-two"></div>

      <div class="glow glow-one"></div>
      <div class="glow glow-two"></div>

      <div class="portrait-card">
        <div class="portrait-frame">
          <img
            src="/images/profile_image.webp"
            alt="Emran Masoumifeshani — PhD Scientist and AI/ML Engineer"
          />
        </div>

        <div class="portrait-label">
          <div>
            <strong>Warsaw, Poland</strong>
            <span>Science → AI Engineering</span>
          </div>
          <span class="portrait-mark">EM</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STATEMENT -->
  <section class="statement section-shell">
    <div class="statement-line"></div>

    <p>
      I build systems where
      <span>science, data and AI</span>
      meet practical engineering.
    </p>
  </section>

  <!-- SELECTED WORK -->
  <section class="section-shell section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected Work</p>
      </div>

      <div>
        <h2>Projects with real engineering depth.</h2>
        <p class="section-lead">
          From scientific software to AI-powered products, my work sits at
        </p>
      </div>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-top">
            <span class="project-number">{project.id}</span>
            <span class="project-arrow">↗</span>
          </div>

          <div class="project-content">
            <h3>{project.title}</h3>
            <p>{project.desc}</p>
            <small>{project.stack}</small>
          </div>

          <a href={`/projects/${project.slug}`} class="project-link">
            View project
            <span>→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- JOURNEY -->
  <section class="section-shell section-block journey-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">My Journey</p>
      </div>

      <div>
        <h2>A career built across science, engineering and AI.</h2>
      </div>
    </div>

    <div class="timeline">
      {journey.map((item, index) => (
        <div class="timeline-item">
          <div class="timeline-marker">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </div>

          <div class="timeline-year">{item.year}</div>

          <div class="timeline-content">
            <h3>{item.title}</h3>
            <strong>{item.place}</strong>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- TECHNICAL FOCUS -->
  <section class="section-shell section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Technical Focus</p>
      </div>

      <div>
        <h2>The tools and disciplines behind my work.</h2>
      </div>
    </div>

    <div class="skill-grid">
      {skills.map((skill, index) => (
        <div class="skill-item">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{skill}</strong>
        </div>
      ))}
    </div>
  </section>

  <!-- RESEARCH -->
  <section class="section-shell section-block research-highlight">
    <div class="research-panel">
      <div class="research-copy">
        <p class="eyebrow">Research</p>

        <h2>
          A scientific foundation behind the engineering.
        </h2>

        <p>
          My research background is in computational chemistry and scientific
          computing, with a PhD focused on computational approaches to
          molecular systems.
        </p>

        <a class="text-link" href="/research">
          Explore my research
          <span>→</span>
        </a>
      </div>

      <div class="research-stats">
        <div>
          <strong>PhD</strong>
          <span>Quantum Chemistry</span>
        </div>

        <div>
          <strong>C++</strong>
          <span>Scientific Software</span>
        </div>

        <div>
          <strong>Python</strong>
          <span>Computational Research</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WRITING -->
  <section class="section-shell section-block writing-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Writing</p>
      </div>

      <div>
        <h2>Notes from building, learning and researching.</h2>
      </div>
    </div>

    <div class="writing-grid">
      <a href="/blog" class="writing-card">
        <span>AI Engineering</span>
        <h3>Building Reliable RAG Systems</h3>
        <p>
          Architecture, retrieval, evaluation and practical deployment.
        </p>
        <strong>Read more →</strong>
      </a>

      <a href="/blog" class="writing-card">
        <span>Career & Research</span>
        <h3>From Computational Chemistry to AI Engineering</h3>
        <p>
          How scientific thinking shaped the way I approach AI systems.
        </p>
        <strong>Read more →</strong>
      </a>

      <a href="/blog" class="writing-card">
        <span>Machine Learning</span>
        <h3>RAG vs Fine-Tuning</h3>
        <p>
          A practical framework for choosing the right approach.
        </p>
        <strong>Read more →</strong>
      </a>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section-shell contact-band">
    <div>
      <p class="eyebrow">Let's Build Something Useful</p>

      <h2>
        Interested in AI, data or intelligent product development?
      </h2>

      <p>
        I'm open to opportunities where scientific thinking and AI engineering
        can create measurable impact.
      </p>
    </div>

    <a class="btn primary" href="/contact">
      Get in touch
      <span>→</span>
    </a>
  </section>
</BaseLayout>
