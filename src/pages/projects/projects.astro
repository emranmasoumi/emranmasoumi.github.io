---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  {
    number: '01',
    slug: 'ai-product-recommendation',
    title: 'AI-Powered Product Recommendation System',
    category: 'AI Engineering · E-Commerce',
    role: 'AI & Python Developer · Solution Architect',
    description:
      'An AI-powered application for an e-commerce rug business, combining room visualization, image processing and product recommendation workflows.',
    image: '/images/projects/ai-recommendation.jpg',
    stack: ['Python', 'FastAPI', 'AI / Computer Vision', 'Docker', 'REST API']
  },
  {
    number: '02',
    slug: 'customer-segmentation',
    title: 'Customer Segmentation & E-Commerce Analytics',
    category: 'Data Science · Machine Learning',
    role: 'Data Scientist · Machine Learning Engineer',
    description:
      'An end-to-end analytics and machine learning pipeline for transforming transactional data into customer segments and actionable business insights.',
    image: '/images/projects/customer-segmentation.jpg',
    stack: ['Python', 'Pandas', 'scikit-learn', 'Machine Learning', 'Data Science']
  },
  {
    number: '03',
    slug: 'rag-document-assistant',
    title: 'RAG Document Assistant',
    category: 'LLM Engineering · Generative AI',
    role: 'AI / LLM Engineer',
    description:
      'A modular Retrieval-Augmented Generation application that lets users ask natural-language questions about their documents and receive grounded answers.',
    image: '/images/projects/rag-assistant.jpg',
    stack: ['Python', 'RAG', 'LLMs', 'LangChain', 'FastAPI']
  },
  {
    number: '04',
    slug: 'arofrag',
    title: 'Scientific Computing & Automation Software',
    category: 'Scientific Computing · C++ / Python',
    role: 'Lead Developer · Computational Scientist',
    description:
      'AROFRAG automates complex molecular fragmentation and computational workflows for large-scale quantum chemistry calculations.',
    image: '/images/projects/arofrag.jpg',
    stack: ['Python', 'C++', 'Algorithm Development', 'Automation', 'Scientific Computing']
  }
];
---

<BaseLayout title="Projects — Emran Masoumifeshani">
  <section class="section-shell projects-hero">
    <div>
      <p class="eyebrow">Selected Work</p>
      <h1>
        Projects where
        <span>science meets software.</span>
      </h1>
    </div>

    <div class="projects-hero-side">
      <p>
        A selection of work across AI engineering, machine learning,
        LLM applications and scientific computing.
      </p>
      <span>04 PROJECTS · AI · ML · LLM · SCIENTIFIC COMPUTING</span>
    </div>
  </section>

  <section class="section-shell projects-list">
    {projects.map((project) => (
      <article class="project-feature">
        <a href={`/projects/${project.slug}`} class="project-image-link" aria-label={`View ${project.title}`}>
          <div class="project-image-wrap">
            <img src={project.image} alt={project.title} loading="lazy" />
            <span class="project-image-arrow">↗</span>
          </div>
        </a>

        <div class="project-feature-copy">
          <div class="project-feature-meta">
            <span>{project.number}</span>
            <span>{project.category}</span>
          </div>

          <h2>{project.title}</h2>

          <p class="project-role">{project.role}</p>

          <p class="project-feature-description">{project.description}</p>

          <div class="project-tags">
            {project.stack.map((item) => <span>{item}</span>)}
          </div>

          <a class="text-link" href={`/projects/${project.slug}`}>
            View case study <span>→</span>
          </a>
        </div>
      </article>
    ))}
  </section>

  <section class="section-shell contact-band projects-cta">
    <div>
      <p class="eyebrow">Let's Work Together</p>
      <h2>Have a complex problem worth solving?</h2>
      <p>
        I'm interested in AI, data and intelligent software systems that create
        measurable value.
      </p>
    </div>

    <a class="btn primary" href="/contact">
      Get in touch <span>→</span>
    </a>
  </section>
</BaseLayout>
