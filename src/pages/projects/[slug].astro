---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} — Emran Masoumifeshani`}>
  <article class="case-study">
    <section class="section-shell case-hero">
      <div class="case-hero-copy">
        <a class="back-link" href="/projects">← All projects</a>
        <p class="eyebrow">{project.number} · {project.category}</p>
        <h1>{project.title}</h1>
        <p class="case-role">{project.role}</p>
        <p class="case-summary">{project.summary}</p>
      </div>

      <div class="case-hero-image">
        <img src={project.image} alt={project.title} />
      </div>
    </section>

    <section class="section-shell case-body">
      <div class="case-sidebar">
        <span class="case-label">Technologies</span>
        <div class="case-tech-list">
          {project.technologies.map((item) => <span>{item}</span>)}
        </div>
      </div>

      <div class="case-content">
        <section>
          <p class="eyebrow">Overview</p>
          <h2>The problem and the approach.</h2>
          <p>{project.overview}</p>
        </section>

        <section>
          <p class="eyebrow">What I Built</p>
          <h2>From architecture to implementation.</h2>
          <ul class="case-list">
            {project.built.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="case-outcome">
          <p class="eyebrow">Outcome</p>
          <h2>What the work achieved.</h2>
          <p>{project.outcome}</p>
        </section>
      </div>
    </section>

    <section class="section-shell case-navigation">
      <a href="/projects">← Back to all projects</a>
    </section>
  </article>
</BaseLayout>
