---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts } from '../../data/blog';

const posts = blogPosts
  .filter((post) => post.featured !== false)
  .sort(
    (a, b) =>
      new Date(b.date).getTime() - new Date(a.date).getTime()
  );
---

<BaseLayout title="Blog — Emran Masoumifeshani">
  <section class="section-shell projects-hero">
    <div>
      <p class="eyebrow">Writing</p>
      <h1>
        Ideas on
        <span>AI, data and research.</span>
      </h1>
    </div>

    <div class="projects-hero-side">
      <p>
        Notes from building, learning and researching across artificial
        intelligence, data science, software engineering and computational
        research.
      </p>

      <span>{posts.length} ARTICLES · AI · DATA · RESEARCH</span>
    </div>
  </section>

  <section class="section-shell blog-list">
    {posts.map((post) => (
      <article class="blog-feature">
        <div class="blog-feature-copy">
          <div class="blog-feature-meta">
            <span>{post.number}</span>
            <span>{post.category}</span>
            <span>{post.readTime}</span>
          </div>

          <h2>{post.title}</h2>

          <p class="blog-date">
            {new Date(post.date).toLocaleDateString('en-GB', {
              day: '2-digit',
              month: 'short',
              year: 'numeric'
            })}
          </p>

          <p class="blog-feature-description">
            {post.excerpt}
          </p>

          <div class="blog-tags">
            {post.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>

          <a class="text-link" href={`/blog/${post.slug}`}>
            Read article <span>→</span>
          </a>
        </div>
      </article>
    ))}
  </section>

  <section class="section-shell contact-band">
    <div>
      <p class="eyebrow">Get in touch</p>
      <h2>Have an idea worth discussing?</h2>

      <p>
        I'm always interested in interesting problems at the intersection
        of AI, data, science and software.
      </p>
    </div>

    <a class="btn primary" href="/contact">
      Contact me <span>→</span>
    </a>
  </section>
</BaseLayout>

<style>
  .blog-list {
    display: grid;
    gap: 1.5rem;
  }

  .blog-feature {
    border-top: 1px solid var(--border-color, rgba(255, 255, 255, 0.12));
    padding-top: 2rem;
  }

  .blog-feature-copy {
    max-width: 900px;
  }

  .blog-feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .blog-feature h2 {
    margin: 0;
    max-width: 800px;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.15;
  }

  .blog-date {
    margin: 0.8rem 0 1.25rem;
    font-size: 0.9rem;
    opacity: 0.55;
  }

  .blog-feature-description {
    max-width: 720px;
    font-size: 1.05rem;
    line-height: 1.75;
    opacity: 0.8;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.5rem 0;
  }

  .blog-tags span {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.12));
    border-radius: 999px;
    font-size: 0.78rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
</style>
